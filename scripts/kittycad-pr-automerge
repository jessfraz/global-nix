#!/usr/bin/env bash
set -euo pipefail

ORG="KittyCAD"
BOT_AUTHOR_LEGACY="zoo-github-actions-auth[bot]"
BOT_AUTHOR_APP="app/zoo-github-actions-auth"
MODELING_BOT_AUTHOR_LEGACY="modeling-app-github-app[bot]"
MODELING_BOT_AUTHOR_APP="app/modeling-app-github-app"
DEPENDABOT_AUTHOR="dependabot[bot]"
IGNORED_REPO="${ORG}/engine"

TARGET_REPOS=(
  "cli"
  "kittycad.rs"
  "kittycad.go"
  "kittycad.py"
  "kittycad.ts"
  "website"
)

DRY_RUN=0
processed=0
skipped=0
errors=0

# Query both viewer review state and auto-merge state at once so repeated runs stay idempotent.
# shellcheck disable=SC2016
PR_STATE_QUERY='query($owner: String!, $name: String!, $number: Int!) {
  viewer {
    login
  }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      autoMergeRequest {
        enabledAt
      }
      latestOpinionatedReviews(first: 100) {
        nodes {
          author {
            login
          }
          state
        }
      }
    }
  }
}'

log() {
  printf '[kittycad-pr-automerge] %s\n' "$*"
}

warn() {
  printf '[kittycad-pr-automerge] WARN: %s\n' "$*" >&2
}

ignore_pr_if_configured() {
  local repo="$1"
  local pr="$2"
  local title="$3"

  if [ "$repo" != "$IGNORED_REPO" ]; then
    return 1
  fi

  log "ignoring configured repository: $repo#$pr ($title)"
  skipped=$((skipped + 1))
  return 0
}

usage() {
  cat <<'EOF'
Usage: kittycad-pr-automerge [--dry-run]

Approves and enables auto-merge for:
1) "Update api spec" PRs (update-spec branch) in:
   KittyCAD/cli, kittycad.rs, kittycad.go, kittycad.py, kittycad.ts, website
2) Open Dependabot PRs across org KittyCAD where review is requested from you
   (excluding KittyCAD/engine)
   (if PR is behind base, comments "@dependabot rebase", regardless of CI)
   (if CI is failing and the PR is not behind, reruns failed CI jobs)
   (still approves and enables auto-merge)
3) Open API inbound spec PRs in KittyCAD/api with titles:
   - Update engine-api spec
   - Update text-to-cad spec
   - Update proprietary-to-kcl spec
4) Generated docs PRs in KittyCAD/documentation:
   - Modeling-app GitHub App: "Update KCL docs" / update-kcl-docs
   - Zoo GitHub App: "Update CLI docs for <version>" / update-docs-<version>
5) SDK-generated spec docs PRs in KittyCAD/website from the Zoo GitHub App:
   - Rust: update-spec-rust / "Update rust lang spec docs for <version>"
   - Go: update-spec-go / "Update go lang spec docs for <version>"
   - Python: update-spec-python / "Update lang spec docs for python"
   - TypeScript: update-spec-typescript / "Update lang spec docs for typescript"
6) Homebrew formula PRs in KittyCAD/homebrew-kittycad from the Zoo GitHub App:
   - "Update tap formula" / update-tap-formula
EOF
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "missing required command: $cmd" >&2
    exit 1
  fi
}

ensure_github_access() {
  if [ -n "${GITHUB_TOKEN:-}" ] || [ -n "${GH_TOKEN:-}" ]; then
    export GH_TOKEN="${GH_TOKEN:-$GITHUB_TOKEN}"
    return 0
  fi
  require_cmd with-credentials
  export SWITCHBOARD_RUN_ID="${SWITCHBOARD_RUN_ID:-kittycad-pr-automerge-$(date +%s)-$$}"
}

# CI supplies its installation token explicitly. Local calls use the configured
# namespace, so auth recovery and operation receipts have one owner.
gh() {
  if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ]; then
    command gh "$@"
    return $?
  fi
  local mode=()
  case "$1 ${2:-}" in
    'pr merge'|'pr review'|'pr comment'|'run rerun') mode=(--apply) ;;
  esac
  with-credentials "${mode[@]}" "${SWITCHBOARD_GITHUB_NAMESPACE:-github.personal}" -- gh "$@"
}

stop_if_uncertain() {
  local status="$1"
  local context="$2"
  local output="$3"
  if [ "$status" -eq 70 ]; then
    warn "$context: provider write outcome is unknown; stopping without retrying or proceeding to another write"
    if [ -n "$output" ]; then
      printf '%s\n' "$output" >&2
    fi
    exit 70
  fi
}

fetch_pr_state_json() {
  local repo="$1"
  local pr="$2"
  local owner="${repo%%/*}"
  local name="${repo#*/}"

  gh api graphql \
    -f owner="$owner" \
    -f name="$name" \
    -F number="$pr" \
    -f query="$PR_STATE_QUERY" 2>/dev/null || true
}

viewer_already_approved_pr() {
  local pr_state_json="$1"

  [ -n "$pr_state_json" ] || return 1

  jq -e '
    (.data.viewer.login // "") as $viewer
    | [
        .data.repository.pullRequest.latestOpinionatedReviews.nodes[]?
        | select((.author.login // "") == $viewer and .state == "APPROVED")
      ]
    | length > 0
  ' <<<"$pr_state_json" >/dev/null 2>&1
}

auto_merge_already_enabled() {
  local pr_state_json="$1"

  [ -n "$pr_state_json" ] || return 1

  jq -e '
    .data.repository.pullRequest != null
    and .data.repository.pullRequest.autoMergeRequest != null
  ' <<<"$pr_state_json" >/dev/null 2>&1
}

pr_state_json_is_usable() {
  local pr_state_json="$1"

  [ -n "$pr_state_json" ] || return 1

  jq -e '
    .errors == null
    and .data.repository.pullRequest != null
    and (.data.viewer.login // "") != ""
  ' <<<"$pr_state_json" >/dev/null 2>&1
}

enable_auto_merge() {
  local repo="$1"
  local pr="$2"
  local pr_state_json="${3:-}"
  local output=""
  local rc=0

  if auto_merge_already_enabled "$pr_state_json"; then
    log "auto-merge already enabled: $repo#$pr"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "[dry-run] auto-merge -> $repo#$pr"
    return 0
  fi

  for method in squash merge rebase; do
    output="$(gh pr merge "$pr" -R "$repo" --auto "--$method" --delete-branch=false 2>&1)" && {
      log "enabled auto-merge ($method): $repo#$pr"
      return 0
    }
    rc=$?
    stop_if_uncertain "$rc" "enable auto-merge ($method) for $repo#$pr" "$output"
    if printf '%s' "$output" | grep -qiE 'already.*auto-merge|auto-merge.*already|already queued'; then
      log "auto-merge already enabled: $repo#$pr"
      return 0
    fi
  done

  warn "failed to enable auto-merge for $repo#$pr (exit $rc): $output"
  return 1
}

approve_pr() {
  local repo="$1"
  local pr="$2"
  local pr_state_json="${3:-}"
  local output=""

  if viewer_already_approved_pr "$pr_state_json"; then
    log "approval already exists: $repo#$pr"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "[dry-run] approve -> $repo#$pr"
    return 0
  fi

  output="$(gh pr review "$pr" -R "$repo" --approve -b "Automated approval." 2>&1)" && {
    log "approved: $repo#$pr"
    return 0
  }

  stop_if_uncertain "$?" "approve $repo#$pr" "$output"

  # Approval failures are non-fatal, e.g. already reviewed or self-approval rules.
  warn "approval skipped for $repo#$pr: $output"
  return 0
}

process_pr() {
  local repo="$1"
  local pr="$2"
  local title="$3"
  local reason="$4"
  local pr_state_json=""

  if ignore_pr_if_configured "$repo" "$pr" "$title"; then
    return 0
  fi

  log "$reason -> $repo#$pr ($title)"
  pr_state_json="$(fetch_pr_state_json "$repo" "$pr")"
  if ! pr_state_json_is_usable "$pr_state_json"; then
    warn "could not inspect current PR state for $repo#$pr, proceeding without duplicate-action guard"
    pr_state_json=""
  fi
  approve_pr "$repo" "$pr" "$pr_state_json"
  if enable_auto_merge "$repo" "$pr" "$pr_state_json"; then
    processed=$((processed + 1))
  else
    errors=$((errors + 1))
  fi
}

ci_is_green() {
  local repo="$1"
  local pr="$2"
  local checks=""
  local failing=0

  checks="$(gh pr checks "$pr" -R "$repo" --required --json state 2>/dev/null || true)"
  if [ -z "$checks" ] || [ "$checks" = "[]" ]; then
    checks="$(gh pr checks "$pr" -R "$repo" --json state 2>/dev/null || true)"
  fi

  if [ -z "$checks" ] || [ "$checks" = "[]" ]; then
    return 1
  fi

  failing="$(jq '[.[] | select(.state != "SUCCESS" and .state != "SKIPPED" and .state != "NEUTRAL")] | length' <<<"$checks")"
  [ "$failing" -eq 0 ]
}

needs_rebase() {
  local repo="$1"
  local pr="$2"
  local merge_state=""

  merge_state="$(gh pr view "$pr" -R "$repo" --json mergeStateStatus --jq '.mergeStateStatus' 2>/dev/null || true)"
  [ "$merge_state" = "BEHIND" ]
}

already_requested_dependabot_rebase() {
  local repo="$1"
  local pr="$2"
  local comments_json=""

  comments_json="$(gh pr view "$pr" -R "$repo" --json comments 2>/dev/null || true)"
  if [ -z "$comments_json" ]; then
    return 1
  fi

  jq -e '
    .comments[]?
    | (.body // "")
    | gsub("\r"; "")
    | test("^@dependabot rebase[[:space:]]*$")
  ' <<<"$comments_json" >/dev/null 2>&1
}

request_dependabot_rebase() {
  local repo="$1"
  local pr="$2"
  local output=""

  if ! needs_rebase "$repo" "$pr"; then
    return 0
  fi

  if already_requested_dependabot_rebase "$repo" "$pr"; then
    log "dependabot rebase already requested: $repo#$pr"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "[dry-run] comment rebase -> $repo#$pr"
    return 0
  fi

  output="$(gh pr comment "$pr" -R "$repo" --body "@dependabot rebase" 2>&1)" && {
    log "requested dependabot rebase: $repo#$pr"
    return 0
  }

  stop_if_uncertain "$?" "request dependabot rebase for $repo#$pr" "$output"

  warn "failed to request dependabot rebase for $repo#$pr: $output"
  return 0
}

rerun_failed_ci_jobs() {
  local repo="$1"
  local pr="$2"
  local head_sha=""
  local runs_json=""
  local run_id=""
  local output=""
  local reran=0

  head_sha="$(gh pr view "$pr" -R "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
  if [ -z "$head_sha" ]; then
    warn "could not determine head SHA for $repo#$pr, skipping CI rerun request"
    return 0
  fi

  runs_json="$(gh run list -R "$repo" --commit "$head_sha" --json databaseId,status,conclusion --limit 100 2>/dev/null || true)"
  if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
    log "no workflow runs found for $repo#$pr head $head_sha"
    return 0
  fi

  while IFS= read -r run_id; do
    [ -n "$run_id" ] || continue
    if [ "$DRY_RUN" -eq 1 ]; then
      log "[dry-run] rerun failed jobs -> $repo#$pr run $run_id"
      reran=1
      continue
    fi

    output="$(gh run rerun "$run_id" -R "$repo" --failed 2>&1)" && {
      log "reran failed CI jobs: $repo#$pr run $run_id"
      reran=1
      continue
    }

    stop_if_uncertain "$?" "rerun failed CI jobs for $repo#$pr run $run_id" "$output"

    warn "failed to rerun failed CI jobs for $repo#$pr run $run_id: $output"
  done < <(
    jq -r '
      .[]
      | select(.status == "completed")
      | select(
          .conclusion == "failure"
          or .conclusion == "timed_out"
          or .conclusion == "startup_failure"
          or .conclusion == "cancelled"
          or .conclusion == "action_required"
          or .conclusion == "stale"
        )
      | .databaseId
    ' <<<"$runs_json"
  )

  if [ "$reran" -eq 0 ]; then
    log "no failed completed CI runs to rerun: $repo#$pr"
  fi

  return 0
}

process_update_spec_repo_prs() {
  local repo_short=""
  local repo=""
  local prs_json=""
  local row=""
  local pr_number=""
  local title=""

  log "scanning spec and SDK docs sync PRs in target repos..."
  for repo_short in "${TARGET_REPOS[@]}"; do
    repo="${ORG}/${repo_short}"
    prs_json="$(gh pr list -R "$repo" --state open --limit 100 --json number,title,headRefName,author,isDraft,url)"
    while IFS= read -r row; do
      pr_number="$(jq -r '.number' <<<"$row")"
      title="$(jq -r '.title' <<<"$row")"
      process_pr "$repo" "$pr_number" "$title" "repo spec/docs sync"
    done < <(
      jq -c --arg bot_legacy "$BOT_AUTHOR_LEGACY" --arg bot_app "$BOT_AUTHOR_APP" \
        --arg repo "$repo" --arg website "${ORG}/website" '
        .[]
        | select(.isDraft == false)
        | select(.author.login == $bot_legacy or .author.login == $bot_app)
        | select(
            (.title == "Update api spec" and .headRefName == "update-spec")
            or ($repo == $website and (
              (.headRefName == "update-spec-rust"
                and (.title | startswith("Update rust lang spec docs for ")))
              or (.headRefName == "update-spec-go"
                and (.title | startswith("Update go lang spec docs for ")))
              or (.headRefName == "update-spec-python"
                and .title == "Update lang spec docs for python")
              or (.headRefName == "update-spec-typescript"
                and .title == "Update lang spec docs for typescript")
            ))
          )
      ' <<<"$prs_json"
    )
  done
}

process_dependabot_prs() {
  local prs_json=""
  local row=""
  local repo=""
  local pr_number=""
  local title=""
  local ci_green=0
  local behind=0
  local review_requested="${DEPENDABOT_REVIEW_REQUESTED:-@me}"

  log "scanning open Dependabot PRs in ${ORG} requested for review by ${review_requested}..."
  prs_json="$(gh search prs --owner "$ORG" --author "$DEPENDABOT_AUTHOR" --state open --review-requested "$review_requested" --limit 500 --json number,title,repository,isDraft,url)"
  while IFS= read -r row; do
    repo="$(jq -r '.repository.nameWithOwner' <<<"$row")"
    pr_number="$(jq -r '.number' <<<"$row")"
    title="$(jq -r '.title' <<<"$row")"

    if ignore_pr_if_configured "$repo" "$pr_number" "$title"; then
      continue
    fi

    ci_green=0
    behind=0

    if ci_is_green "$repo" "$pr_number"; then
      ci_green=1
    fi

    if needs_rebase "$repo" "$pr_number"; then
      behind=1
    fi

    if [ "$behind" -eq 1 ]; then
      request_dependabot_rebase "$repo" "$pr_number"
      if [ "$ci_green" -eq 1 ]; then
        process_pr "$repo" "$pr_number" "$title" "dependabot (CI green, needs rebase)"
      else
        process_pr "$repo" "$pr_number" "$title" "dependabot (CI not green, needs rebase)"
      fi
    elif [ "$ci_green" -eq 1 ]; then
      process_pr "$repo" "$pr_number" "$title" "dependabot (CI green)"
    else
      rerun_failed_ci_jobs "$repo" "$pr_number"
      process_pr "$repo" "$pr_number" "$title" "dependabot (CI not green)"
    fi
  done < <(jq -c '.[] | select(.isDraft == false)' <<<"$prs_json")
}

select_documentation_sync_prs() {
  jq -c --arg modeling_legacy "$MODELING_BOT_AUTHOR_LEGACY" --arg modeling_app "$MODELING_BOT_AUTHOR_APP" \
    --arg zoo_legacy "$BOT_AUTHOR_LEGACY" --arg zoo_app "$BOT_AUTHOR_APP" '
    .[]
    | select(.isDraft == false)
    | select(
        ((.author.login == $modeling_legacy or .author.login == $modeling_app)
          and .title == "Update KCL docs" and .headRefName == "update-kcl-docs")
        or ((.author.login == $zoo_legacy or .author.login == $zoo_app)
          and (.title | startswith("Update CLI docs for "))
          and (.title | ltrimstr("Update CLI docs for ") | length > 0)
          and .headRefName == ("update-docs-" + (.title | ltrimstr("Update CLI docs for "))))
      )
  '
}

process_documentation_prs() {
  local repo="${ORG}/documentation"
  local prs_json=""
  local row=""
  local pr_number=""
  local title=""

  log "scanning open KCL and CLI docs sync PRs..."
  prs_json="$(gh pr list -R "$repo" --state open --limit 100 --json number,title,headRefName,author,isDraft,url)"
  while IFS= read -r row; do
    pr_number="$(jq -r '.number' <<<"$row")"
    title="$(jq -r '.title' <<<"$row")"
    process_pr "$repo" "$pr_number" "$title" "documentation sync"
  done < <(select_documentation_sync_prs <<<"$prs_json")
}

select_homebrew_formula_prs() {
  jq -c --arg bot_legacy "$BOT_AUTHOR_LEGACY" --arg bot_app "$BOT_AUTHOR_APP" '
    .[]
    | select(.isDraft == false)
    | select(.author.login == $bot_legacy or .author.login == $bot_app)
    | select(.title == "Update tap formula" and .headRefName == "update-tap-formula")
  '
}

process_homebrew_prs() {
  local repo="${ORG}/homebrew-kittycad"
  local prs_json=""
  local row=""
  local pr_number=""
  local title=""

  log "scanning open Homebrew formula sync PRs..."
  prs_json="$(gh pr list -R "$repo" --state open --limit 100 --json number,title,headRefName,author,isDraft,url)"
  while IFS= read -r row; do
    pr_number="$(jq -r '.number' <<<"$row")"
    title="$(jq -r '.title' <<<"$row")"
    process_pr "$repo" "$pr_number" "$title" "Homebrew formula sync"
  done < <(select_homebrew_formula_prs <<<"$prs_json")
}

process_api_inbound_spec_prs() {
  local repo="${ORG}/api"
  local prs_json=""
  local row=""
  local pr_number=""
  local title=""

  log "scanning open api inbound spec PRs..."
  prs_json="$(gh pr list -R "$repo" --state open --limit 100 --json number,title,author,isDraft,url)"
  while IFS= read -r row; do
    pr_number="$(jq -r '.number' <<<"$row")"
    title="$(jq -r '.title' <<<"$row")"
    process_pr "$repo" "$pr_number" "$title" "api inbound spec sync"
  done < <(
    jq -c --arg bot_legacy "$BOT_AUTHOR_LEGACY" --arg bot_app "$BOT_AUTHOR_APP" '
      .[]
      | select(.isDraft == false)
      | select(.author.login == $bot_legacy or .author.login == $bot_app)
      | select(
          .title == "Update engine-api spec"
          or .title == "Update text-to-cad spec"
          or .title == "Update proprietary-to-kcl spec"
        )
    ' <<<"$prs_json"
  )
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "unknown argument: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  require_cmd gh
  require_cmd jq
  ensure_github_access

  process_update_spec_repo_prs
  process_dependabot_prs
  process_api_inbound_spec_prs
  process_documentation_prs
  process_homebrew_prs

  log "done. processed=$processed skipped=$skipped errors=$errors dry_run=$DRY_RUN"
  if [ "$errors" -gt 0 ]; then
    exit 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
