#!/usr/bin/env python3
"""Clean up one clean, merged local branch/worktree; use --plan to preview."""

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from dataclasses import asdict, dataclass
from pathlib import Path


class CleanupError(Exception):
    pass


def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    env = {
        key: value for key, value in os.environ.items() if not key.startswith("GIT_")
    }
    # Preserve the selected transport, never inherited repository routing.
    for key in ("GIT_SSH", "GIT_SSH_COMMAND", "GIT_ALLOW_PROTOCOL"):
        if key in os.environ:
            env[key] = os.environ[key]
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if check and result.returncode:
        raise CleanupError(result.stderr.strip() or f"git {args[0]} failed")
    return result


def value(root: Path, *args: str) -> str:
    return git(root, *args).stdout.strip()


@dataclass(frozen=True)
class Plan:
    version: int
    repository: str
    worktree: str
    primary_worktree: str
    branch: str
    head: str
    remote: str
    remote_identity: str
    base: str
    base_head: str
    local_base_head: str
    evidence: str
    evidence_commit: str
    force: bool
    remove_worktree: bool
    submodule_storage: str
    submodule_fingerprint: str

    @classmethod
    def read(cls, path: Path) -> "Plan":
        data = json.loads(path.read_text())
        if not isinstance(data, dict) or set(data) != set(cls.__dataclass_fields__):
            raise CleanupError("Invalid cleanup plan schema")
        if type(data["version"]) is not int or data["version"] != 1:
            raise CleanupError("Unsupported cleanup plan version")
        for key, item in data.items():
            expected = bool if key in ("force", "remove_worktree") else str
            if key != "version" and type(item) is not expected:
                raise CleanupError(f"Invalid cleanup plan field: {key}")
        return cls(**data)


def clean(root: Path, *, remove_worktree: bool) -> None:
    # Ignored files are safe to keep when switching branches, not removing a tree.
    ignored = "--ignored=traditional" if remove_worktree else "--ignored=no"
    status = git(
        root,
        "status",
        "--porcelain=v1",
        "--untracked-files=all",
        ignored,
        "--ignore-submodules=none",
    ).stdout
    if status:
        raise CleanupError(
            f"Worktree has local files or changes: {root}\n{status.rstrip()}"
        )
    submodules = git(root, "submodule", "status", "--recursive").stdout
    if any(line and line[0] in "+U" for line in submodules.splitlines()):
        raise CleanupError(
            f"Submodule checkout does not match its recorded commit: {root}"
        )
    # Parent status hides ignored submodule files. Even a branch switch can
    # delete them when the destination replaces a gitlink with a regular file.
    result = git(
        root,
        "submodule",
        "foreach",
        "--quiet",
        "--recursive",
        "status=$(git status --porcelain=v1 --untracked-files=all --ignored "
        "--ignore-submodules=none) || exit; "
        'if test -n "$status"; then printf "%s\\n%s\\n" "$displaypath" "$status"; exit 1; fi',
        check=False,
    )
    if result.returncode:
        raise CleanupError(
            f"Submodule has local files or changes: {root}\n"
            f"{result.stdout.rstrip() or result.stderr.rstrip()}"
        )


def patch_id(patch: str) -> str | None:
    result = subprocess.run(
        ["git", "patch-id", "--stable"],
        input=patch,
        text=True,
        capture_output=True,
        check=True,
    )
    return result.stdout.split()[0] if result.stdout.strip() else None


def submodule_storage(root: Path) -> tuple[str, str]:
    storage = Path(value(root, "rev-parse", "--absolute-git-dir")) / "modules"
    if storage.is_symlink():
        raise CleanupError(
            "Submodule Git storage is a symlink; preserve it manually before cleanup"
        )
    if not storage.exists():
        return "", ""
    fingerprint = hashlib.sha256()
    for path in sorted(storage.rglob("*")):
        if path.is_symlink():
            raise CleanupError(
                "Submodule Git storage contains symlinks; preserve it manually before cleanup"
            )
        if path.is_file():
            # Read-only status refreshes index timestamps; fetch refreshes
            # FETCH_HEAD. Neither changes the refs/objects we must retain.
            if path.name in ("index", "FETCH_HEAD"):
                continue
            if (
                path.name == "alternates"
                and path.parent.name == "info"
                and path.read_text().strip()
            ):
                raise CleanupError(
                    "Submodule Git storage depends on alternate object stores; preserve it manually before cleanup"
                )
            info = path.stat()
            fingerprint.update(
                f"{path.relative_to(storage)}:{info.st_size}:{info.st_mtime_ns}\n".encode()
            )
    return str(storage), fingerprint.hexdigest()


def merged(root: Path, head: str, base: str) -> tuple[str, str]:
    if (
        git(root, "merge-base", "--is-ancestor", head, base, check=False).returncode
        == 0
    ):
        return "ancestor", head
    ancestor = value(root, "merge-base", head, base)
    paths = git(root, "diff", "--name-only", "-z", ancestor, head).stdout.split("\0")[
        :-1
    ]
    if not paths:
        return "empty-change", ancestor
    expected = patch_id(git(root, "diff", "--binary", ancestor, head).stdout)
    history = git(
        root,
        "log",
        "--first-parent",
        "-p",
        "--binary",
        "--format=commit %H",
        f"{ancestor}..{base}",
    ).stdout
    candidates = subprocess.run(
        ["git", "patch-id", "--stable"],
        input=history,
        text=True,
        capture_output=True,
        check=True,
    ).stdout
    for line in candidates.splitlines():
        candidate_patch, commit = line.split()
        # patch-id ignores whitespace, so compare exact content as well.
        if (
            candidate_patch == expected
            and git(
                root, "diff", "--quiet", head, commit, "--", *paths, check=False
            ).returncode
            == 0
        ):
            return "squash-patch-and-content", commit
    return "unmerged", ""


def prepare(root: Path, remote: str, base: str | None, force: bool) -> Plan:
    root = Path(value(root, "rev-parse", "--show-toplevel")).resolve()
    repository = value(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    records = git(root, "worktree", "list", "--porcelain", "-z").stdout.split("\0\0")
    worktrees = [
        dict(
            field.split(" ", 1) if " " in field else (field, "")
            for field in record.split("\0")
            if field
        )
        for record in records
        if record
    ]
    primary = Path(worktrees[0]["worktree"]).resolve()
    if "bare" in worktrees[0]:
        raise CleanupError("Cleanup from a bare primary repository is not supported")
    for worktree in worktrees:
        if Path(worktree["worktree"]).resolve() == root and "locked" in worktree:
            raise CleanupError(
                "Worktree is locked; unlock it explicitly before cleanup"
            )
    branch = git(root, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if branch.returncode:
        raise CleanupError("Detached HEAD cannot be cleaned up automatically")
    branch_name = branch.stdout.strip()
    if remote not in value(root, "remote").splitlines():
        raise CleanupError(f"Unknown remote: {remote}")
    # Fetch must succeed before any removal or merge decision.
    git(root, "fetch", "--prune", "--tags", remote)
    if base is None:
        head = git(
            root, "symbolic-ref", "--quiet", f"refs/remotes/{remote}/HEAD", check=False
        )
        if head.returncode == 0:
            base = head.stdout.strip().removeprefix(f"refs/remotes/{remote}/")
        else:
            for candidate in ("main", "master"):
                if (
                    git(
                        root,
                        "show-ref",
                        "--verify",
                        "--quiet",
                        f"refs/heads/{candidate}",
                        check=False,
                    ).returncode
                    == 0
                ):
                    base = candidate
                    break
            if base is None:
                raise CleanupError("Remote default branch is unknown; pass --base")
    if git(root, "check-ref-format", f"refs/heads/{base}", check=False).returncode:
        raise CleanupError("Invalid base branch")
    if branch_name == base and root != primary:
        raise CleanupError("Refusing to remove a worktree containing the base branch")
    clean(root, remove_worktree=root != primary)
    head = value(root, "rev-parse", "HEAD")
    base_head = value(
        root, "rev-parse", "--verify", f"refs/remotes/{remote}/{base}^{{commit}}"
    )
    evidence, commit = (
        ("base-branch", head) if branch_name == base else merged(root, head, base_head)
    )
    if evidence == "unmerged" and not force:
        raise CleanupError(
            "Branch is not merged or squash-equivalent; --force waives only this check"
        )
    local_base_head = value(
        root, "rev-parse", "--verify", f"refs/heads/{base}^{{commit}}"
    )
    for worktree in worktrees:
        if (
            worktree.get("branch") == f"refs/heads/{base}"
            and Path(worktree["worktree"]).resolve() != primary
        ):
            raise CleanupError("Base branch is checked out in another worktree")
    storage, fingerprint = submodule_storage(root) if root != primary else ("", "")
    return Plan(
        1,
        repository,
        str(root),
        str(primary),
        branch_name,
        head,
        remote,
        hashlib.sha256(value(root, "remote", "get-url", remote).encode()).hexdigest(),
        base,
        base_head,
        local_base_head,
        evidence,
        commit,
        force,
        root != primary,
        storage,
        fingerprint,
    )


def update_base(plan: Plan) -> None:
    primary = Path(plan.primary_worktree)
    try:
        clean(primary, remove_worktree=False)
    except CleanupError as error:
        if not plan.remove_worktree:
            raise
        print(
            f"Primary worktree is not clean; skipping base update: {error}",
            file=sys.stderr,
        )
        return
    # Both transitions must preserve ignored files, including newly tracked upstream paths.
    git(primary, "switch", "--no-overwrite-ignore", plan.base)
    git(primary, "merge", "--ff-only", "--no-overwrite-ignore", plan.base_head)


def execute(plan: Plan, force: bool, *, no_gc: bool = False) -> str | None:
    if plan.force != force:
        raise CleanupError("Execution --force must match the reviewed plan")
    current = prepare(Path(plan.worktree), plan.remote, plan.base, force)
    if current != plan:
        raise CleanupError("Cleanup evidence changed; generate and review a new plan")
    root = Path(plan.worktree)
    primary = Path(plan.primary_worktree)
    # Finish the potentially failing base update before removing the current checkout.
    update_base(plan)
    archive: Path | None = None
    if plan.remove_worktree:
        clean(root, remove_worktree=True)
        # Git requires --force for populated submodules. Their tracked, untracked,
        # and ignored content was checked recursively immediately before removal.
        has_submodules = bool(git(root, "submodule", "status", "--recursive").stdout)
        args = ["worktree", "remove"]
        if has_submodules:
            args.append("--force")
        if plan.submodule_storage:
            # A clean checkout can still contain unique local branches, stashes,
            # or reflog-only commits. Retain the entire Git store before Git
            # deletes the linked-worktree metadata that owns it.
            archive_root = Path(plan.repository) / "cleanup-submodules"
            archive_root.mkdir(mode=0o700, exist_ok=True)
            archive = Path(tempfile.mkdtemp(prefix="retained-", dir=archive_root))
            Path(plan.submodule_storage).rename(archive / "modules")
        try:
            git(primary, *args, str(root))
        except CleanupError as error:
            if archive:
                try:
                    (archive / "modules").rename(plan.submodule_storage)
                    archive.rmdir()
                except OSError as restore_error:
                    raise CleanupError(
                        f"{error}; submodule storage retained at {archive}: {restore_error}"
                    ) from error
            raise
    # Compare-and-delete protects a branch updated by another process.
    if plan.branch != plan.base:
        try:
            git(primary, "update-ref", "-d", f"refs/heads/{plan.branch}", plan.head)
        except CleanupError as error:
            retained = f"; submodule storage retained at {archive}" if archive else ""
            raise CleanupError(
                f"Worktree cleanup completed; branch was retained: {error}{retained}"
            ) from error
        git(primary, "config", "--remove-section", f"branch.{plan.branch}", check=False)
    # Maintenance failures must not strand gcleanup inside a removed directory.
    maintenance = [("worktree", "prune")]
    if not no_gc:
        maintenance.append(("gc",))
    for command in maintenance:
        result = git(primary, *command, check=False)
        if result.returncode:
            print(
                f"Cleanup completed, but git {' '.join(command)} failed: {result.stderr.strip()}",
                file=sys.stderr,
            )
    return str(archive) if archive else None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--plan", action="store_true", help="Print a JSON plan without cleaning up"
    )
    mode.add_argument(
        "--execute", type=Path, metavar="PLAN", help="Execute a reviewed JSON plan"
    )
    parser.add_argument("-r", "--remote", default="origin")
    parser.add_argument("-b", "--base")
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Allow unmerged commits; never discard local file changes",
    )
    parser.add_argument("--no-gc", action="store_true", help="Skip garbage collection")
    parser.add_argument("--json", action="store_true", help="Print a JSON receipt")
    args = parser.parse_args()
    try:
        plan = (
            Plan.read(args.execute)
            if args.execute
            else prepare(Path.cwd(), args.remote, args.base, args.force)
        )
        if args.plan:
            print(json.dumps(asdict(plan), indent=2))
            return 0
        retained_submodules = execute(plan, args.force, no_gc=args.no_gc)
        summary = f"Cleanup complete: base={plan.base} remote={plan.remote}"
        if plan.branch != plan.base:
            summary += f"\nBranch deleted: {plan.branch}"
        if plan.remove_worktree:
            summary += f"\nWorktree removed: {plan.worktree}\nPrimary worktree: {plan.primary_worktree}"
        if retained_submodules:
            summary += f"\nSubmodule Git storage retained: {retained_submodules}"
        # Older loaded gcleanup functions capture stdout and expect a JSON receipt.
        if args.json or not sys.stdout.isatty():
            print(
                json.dumps(
                    {
                        "status": "completed",
                        "worktree_removed": plan.remove_worktree,
                        "branch_deleted": plan.branch
                        if plan.branch != plan.base
                        else None,
                        "primary_worktree": plan.primary_worktree,
                        "retained_submodules": retained_submodules,
                        "summary": summary,
                    }
                )
            )
        else:
            print(summary)
        return 0
    except (CleanupError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
